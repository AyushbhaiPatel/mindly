{
  "name": "mindly-cli",
  "version": "0.1.2",
  "private": true,
  "description": "The mindly command: shared memory and live coordination for coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@mindly/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mindly": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/main.js', 0o755)\""
  },
  "dependencies": {
    "@mindly/adapters": "workspace:*",
    "@mindly/core": "workspace:*",
    "@mindly/daemon": "workspace:*",
    "@mindly/engine": "workspace:*",
    "@mindly/git": "workspace:*",
    "@mindly/mcp": "workspace:*",
    "@mindly/runners": "workspace:*",
    "@mindly/runtime": "workspace:*",
    "@mindly/store": "workspace:*",
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
